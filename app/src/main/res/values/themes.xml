<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ContactsV2" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primaire</item>
        <item name="colorPrimaryDark">@color/primaire_sombre</item>
        <item name="colorAccent">@color/primaire</item>
        <item name="android:statusBarColor">@color/primaire_sombre</item>
        <item name="android:windowBackground">@color/fond</item>
    </style>

    <style name="TitreEntete">
        <item name="android:background">@color/primaire</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textColor">@color/blanc</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LibelleChamp">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/texte_secondaire</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ChampSaisie">
        <item name="android:background">@drawable/fond_champ</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/texte</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BoutonPlein">
        <item name="android:background">@drawable/fond_bouton</item>
        <item name="android:backgroundTint">@color/primaire</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/blanc</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BoutonContour">
        <item name="android:background">@drawable/fond_bouton_contour</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaire</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
