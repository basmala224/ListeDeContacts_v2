<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_carte"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgPhoto"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/fond_photo"
        android:contentDescription="@string/desc_photo"
        android:scaleType="centerCrop"
        tools:src="@drawable/avatar_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomComplet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texte"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Ben Ali Ahmed" />

        <TextView
            android:id="@+id/tvTelephone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texte_secondaire"
            android:textSize="15sp"
            tools:text="+216 20 000 001" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron" />
</LinearLayout>
